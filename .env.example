# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git or share it publicly.

# --- Server ---
PORT=3000
APP_URL=http://localhost:3000
# Set to "true" once you serve the site over HTTPS (e.g. on Railway)
COOKIE_SECURE=false

# --- Security ---
# Long random string used to sign login sessions (JWT).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- OpenRouter (AI script generation) ---
# Get this key from https://openrouter.ai/keys — it is used ONLY on the server, never in the browser.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Check https://openrouter.ai/models for the exact current slug of the model you want to use.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.2

# --- First admin account (created automatically on first server start) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_NAME=Admin

# --- Digistore24 IPN (Instant Payment Notification) ---
# Set the SAME passphrase here and in your Digistore24 IPN settings.
DIGISTORE24_IPN_PASSPHRASE=replace_with_digistore24_ipn_passphrase
# The product ID(s) in Digistore24 that should grant/renew the plan (comma separated). Leave blank to accept any product.
DIGISTORE24_PRODUCT_IDS=

# --- Whop webhook ---
# Found in your Whop dashboard under Developer > Webhooks.
WHOP_WEBHOOK_SECRET=replace_with_whop_webhook_signing_secret

# --- Plan settings ---
PLAN_CREDITS=900
PLAN_DURATION_DAYS=30
